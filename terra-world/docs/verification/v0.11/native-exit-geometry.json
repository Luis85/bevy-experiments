  "computation_method": {
    "execution": "Python standard-library math/struct/json/hashlib plus Pillow for read-only 16-bit PNG decoding; calculations independently reconstruct the checked-in source contracts.",
    "reference_sources": [
      "crates/terra-core/src/geo.rs",
