{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_goldens.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_goldens.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_on_stop.sh\"",
            "timeout": 1800,
            "statusMessage": "cargo xtask verify --quick"
          }
        ]
      }
    ]
  }
}
